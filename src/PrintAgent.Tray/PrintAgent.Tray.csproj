<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Ver a nota equivalente em PrintAgent.Host.csproj. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\resources\icon-16-256.ico</ApplicationIcon>
    <AssemblyTitle>DiskPrato Print Agent</AssemblyTitle>
    <Product>DiskPrato Print Agent</Product>
    <Company>DiskPrato</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- Só EnumPrinterQueues (lista de filas pra tela de setup) — não referencia
         PrintAgent.Host: Tray e serviço são processos separados de propósito
         (Session 0 isolation, plano §7.4); o contrato entre os dois é o JSON
         do named pipe, não tipos C# compartilhados. -->
    <ProjectReference Include="..\PrintAgent.Printing\PrintAgent.Printing.csproj" />
  </ItemGroup>

</Project>